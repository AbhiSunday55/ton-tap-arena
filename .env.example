# Copy to .env and fill in. NEVER commit a real .env.
DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_DRIVER=tcp
DB_POOL_MAX=2
JWT_SECRET=change-me
AUTH_PROVIDER=local
APP_SLUG=ton-tap-arena
APP_STORAGE_PRESIGN_URL=
APP_STORAGE_TOKEN=
NODE_ENV=development
PORT=3000

# ── Telegram Mini App (SERVER-SIDE ONLY — never expose to the client) ──
# From @BotFather. Used to verify Mini App initData via HMAC-SHA256.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
